APP_ENV=development
APP_SECRET_KEY=replace-with-local-development-secret
DATABASE_URL=postgresql+psycopg://bloomwell:change-me@localhost:5432/bloomwell
POSTGRES_USER=bloomwell
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bloomwell

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=

DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,mr
PDF_TEMP_DIR=/tmp/bloomwell-pdf

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
ENABLE_DOCS=true
TRUSTED_PROXY_IPS=127.0.0.1,::1

# HelpHub and Education
ALLOW_DEMO_RESOURCES=true
ALLOW_DRAFT_CONTENT=true
RESOURCE_STALE_DAYS=180

# Privacy Center & Retention
EXPORT_MAX_RECORDS=50000
BACKUP_RETENTION_DAYS=14

# Doctor-visit Summary
DOCTOR_SUMMARY_MAX_DAYS=366
DOCTOR_SUMMARY_MAX_SYMPTOM_ROWS=500
DOCTOR_SUMMARY_DAILY_LIMIT=5
